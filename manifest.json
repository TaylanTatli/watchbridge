{
  "manifest_version": 3,
  "name": "WatchBridge",
  "version": "0.1.3",
  "description": "Modular Netflix and Crunchyroll watch-history bridge to Simkl.",
  "key": "",
  "action": {
    "default_popup": "src/ui/popup.html",
    "default_title": "WatchBridge"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting"
  ],
  "optional_host_permissions": [
    "https://www.netflix.com/*",
    "https://www.crunchyroll.com/*",
    "https://api.simkl.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/oauth.html"
      ],
      "matches": [
        "https://simkl.com/*"
      ]
    }
  ]
}
